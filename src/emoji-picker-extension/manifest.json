{
  "manifest_version": 3,
  "name": "우클릭 이모지 피커",
  "version": "1.5.0",
  "description": "텍스트 입력창에서 우클릭하면 이모지를 고르고 한국어로 검색할 수 있어요.",
  "permissions": [
    "contextMenus",
    "storage",
    "clipboardWrite",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "data.js",
        "picker.js",
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "이모지 피커"
  },
  "commands": {
    "open-picker": {
      "description": "입력창 커서 위치에 이모지 피커 열기"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "emoji-sprite.webp"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}